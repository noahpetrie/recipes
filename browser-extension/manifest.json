{
  "manifest_version": 3,
  "name": "Add to Kitchen",
  "short_name": "Kitchen",
  "version": "1.0.0",
  "description": "Save the recipe on this page to Kitchen, with its steps, photos and a link back.",
  "action": {
    "default_title": "Add to Kitchen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://kitchen.madiba.ca/*"
  ],
  "key": "",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
